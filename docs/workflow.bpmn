        <dc:Bounds x="426" y="870" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="426" y="922" width="50" height="24" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Reviewer_di" bpmnElement="EndEvent_Reviewer">
        <dc:Bounds x="536" y="877" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="536" y="915" width="36" height="24" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BefundePosten_di" bpmnElement="Task_BefundePosten">
        <dc:Bounds x="632" y="855" width="170" height="80" />
        <bpmndi:BPMNLabel><dc:Bounds x="632" y="937" width="170" height="24" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_FixLoop_di" bpmnElement="EndEvent_FixLoop">
        <dc:Bounds x="862" y="877" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="862" y="915" width="36" height="24" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_CI_di" bpmnElement="StartEvent_CI">
        <dc:Bounds x="100" y="1067" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="100" y="1105" width="36" height="24" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CI_di" bpmnElement="Task_CI">
        <dc:Bounds x="196" y="1045" width="170" height="80" />

      <bpmndi:BPMNShape id="Task_DraftReady_di" bpmnElement="Task_DraftReady">
        <dc:Bounds x="1466" y="360" width="170" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Melden_di" bpmnElement="Task_Melden">
        <dc:Bounds x="1696" y="360" width="170" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Cleanup_di" bpmnElement="Task_Cleanup">
        <dc:Bounds x="2029" y="360" width="170" height="140" />
      </bpmndi:BPMNShape>
